  m_Script: {fileID: 11500000, guid: b7204142d5ac34814a22177685d42da8, type: 3}
  m_Name: Lesson_02
  m_EditorClassIdentifier: EchoCave.Game::EchoCave.Game.TutorialLessonData
  title: Blocked
  width: 4
  height: 3
  bats:
  - cell: {x: 0, y: 1}
    direction: 3
    hidden: 0
  - cell: {x: 2, y: 1}
    direction: 3
    hidden: 0
  moveLimit: 4
  pingBudget: 0
  threeStarMoves: 2
  twoStarMoves: 3
  freeHint: 0
  steps:
  - text: A bat in the way blocks it. Tap the left bat.
    advance: 3
    focus: 1
    focusBatId: 0
    limitTaps: 1
  - text: 'It bounced back and used a move. Moves are limited! Free the path first: tap the other bat.'
    advance: 2
    focus: 1
    focusBatId: 1
    limitTaps: 1
  - text: Now the way is clear. Tap the left bat again.
    advance: 6
    focus: 1
    focusBatId: 0
    limitTaps: 1
