/* The main menu: the logo and the Play button, centred. Sizes are in panel units. */

.menu-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.menu-hidden {
    display: none;
}

/* The How to play button stays out until the presenter says the game has a tutorial. */
.menu-button-hidden {
    display: none;
}

#howto-button,
#challenges-button {
    margin-top: 28px;
}

/* NEW on the Challenges button: a small tag on its top right corner, shown until the list has been opened. */
.menu__badge {
    position: absolute;
    right: -6px;
    top: -18px;
    margin: 0;
    padding: 4px 16px;
    font-size: 26px;
    color: var(--ui-text);
    background-color: rgb(255, 196, 61);
    border-radius: 24px;
    -unity-text-align: middle-center;
}

.menu__logo {
    width: 820px;
    height: 671px;
    margin-bottom: 40px;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("/Assets/EchoCave/Art/Brand/Logo.png");
}

/* Small and dim, at the bottom edge, out of the way of the Play button. */
.menu__version {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 28px;
    margin: 0;
    padding: 0;
    font-size: 28px;
    color: var(--bat-belly);
    opacity: 0.7;
    -unity-text-align: middle-center;
}

/* Landscape has less height, so the logo shrinks and the button sits closer. */
.landscape .menu__logo {
    width: 520px;
    height: 425px;
    margin-bottom: 20px;
}
