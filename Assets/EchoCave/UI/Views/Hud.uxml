<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="../Styles/Theme.uss" />
    <Style src="../Styles/Hud.uss" />

    <!-- Layout containers ignore the pointer, so only the controls below can catch a tap. -->
    <ui:VisualElement name="hud-root" class="hud-root hud-hidden font-medium" picking-mode="Ignore">
        <ui:VisualElement name="safe-area" class="safe-area" picking-mode="Ignore">
            <ui:VisualElement class="hud-content" picking-mode="Ignore">

                <ui:VisualElement class="hud-top" picking-mode="Ignore">
                    <ui:VisualElement class="hud-top__side" picking-mode="Ignore">
                        <ui:Button name="pause-button" class="round-button">
                            <ui:VisualElement class="round-button__lip" picking-mode="Ignore" />
                            <ui:VisualElement class="round-button__face" picking-mode="Ignore">
                                <ui:VisualElement name="pause-icon" class="round-button__icon" picking-mode="Ignore" />
                            </ui:VisualElement>
                        </ui:Button>
                    </ui:VisualElement>

                    <ui:VisualElement class="moves-sign" picking-mode="Ignore">
                        <ui:Label text="MOVES" class="moves-sign__caption font-medium" picking-mode="Ignore" />
                        <ui:Label name="moves-value" text="0" class="moves-sign__value font-bold" picking-mode="Ignore" />
                    </ui:VisualElement>

                    <ui:VisualElement class="hud-top__side hud-top__side--end" picking-mode="Ignore" />
                </ui:VisualElement>

                <ui:VisualElement class="hud-bottom" picking-mode="Ignore">
                    <ui:Button name="ping-button" class="ping-button ping-button--ready">
                        <ui:VisualElement class="ping-button__disc" picking-mode="Ignore">
                            <ui:VisualElement class="ping-button__icon" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:VisualElement class="ping-button__badge" picking-mode="Ignore">
                            <ui:Label name="ping-count" text="0" class="ping-button__count font-bold" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:Button>
                </ui:VisualElement>

            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
