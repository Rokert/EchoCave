<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="../Styles/Theme.uss" />
    <Style src="../Styles/Controls.uss" />
    <Style src="../Styles/Hud.uss" />
    <Style src="../Styles/Popups.uss" />
    <Style src="../Styles/Menu.uss" />
    <Style src="../Styles/Tutorial.uss" />
    <ui:Template name="Tutorial" src="Tutorial.uxml" />
    <ui:Template name="Popups" src="Popups.uxml" />
    <ui:Template name="Menu" src="Menu.uxml" />

    <!-- Layout containers ignore the pointer, so only the controls below can catch a tap. -->
    <ui:VisualElement name="hud-root" class="hud-root hud-hidden font-medium" picking-mode="Ignore">
        <ui:VisualElement name="safe-area" class="safe-area" picking-mode="Ignore">
            <ui:VisualElement class="hud-content" picking-mode="Ignore">

                <ui:VisualElement class="hud-top" picking-mode="Ignore">
                    <ui:VisualElement class="hud-top__side" picking-mode="Ignore">
                        <ui:Button name="pause-button" class="round-button">
                            <ui:VisualElement class="round-button__lip" picking-mode="Ignore" />
                            <ui:VisualElement class="round-button__face" picking-mode="Ignore">
                                <ui:VisualElement name="pause-icon" class="round-button__icon" picking-mode="Ignore" />
                            </ui:VisualElement>
                        </ui:Button>
                    </ui:VisualElement>

                    <ui:VisualElement class="moves-sign" picking-mode="Ignore">
                        <ui:Label text="MOVES" class="moves-sign__caption font-medium" picking-mode="Ignore" />
                        <ui:Label name="moves-value" text="0" class="moves-sign__value font-bold" picking-mode="Ignore" />
                    </ui:VisualElement>

                    <ui:VisualElement class="hud-top__side hud-top__side--end" picking-mode="Ignore">
                        <ui:VisualElement class="moves-sign level-sign" picking-mode="Ignore">
                            <ui:Label name="level-caption" text="LEVEL" class="moves-sign__caption font-medium" picking-mode="Ignore" />
                            <ui:Label name="level-value" text="1" class="moves-sign__value font-bold" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="hud-bottom" picking-mode="Ignore">
                    <ui:Button name="hint-button" class="hint-button hint-button--ready">
                        <ui:VisualElement class="hint-button__disc" picking-mode="Ignore">
                            <ui:VisualElement class="hint-button__icon" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:VisualElement class="hint-button__badge" picking-mode="Ignore">
                            <ui:Label name="hint-count" text="0" class="hint-button__count font-bold" picking-mode="Ignore" />
                            <ui:Label text="AD" class="hint-button__ad font-bold" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:VisualElement class="hint-button__reserve" picking-mode="Ignore">
                            <ui:Label text="+1" class="hint-button__reserve-label font-bold" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:Button>
                    <ui:Button name="ping-button" class="ping-button ping-button--ready">
                        <ui:VisualElement class="ping-button__disc" picking-mode="Ignore">
                            <ui:VisualElement class="ping-button__icon" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:VisualElement class="ping-button__badge" picking-mode="Ignore">
                            <ui:Label name="ping-count" text="0" class="ping-button__count font-bold" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:Button>
                </ui:VisualElement>

            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Above the HUD and below the popups, so the pause popup covers it. Only its buttons catch a pointer. -->
        <ui:Instance template="Tutorial" class="template-fill" picking-mode="Ignore" />
    </ui:VisualElement>

    <!-- A sibling of the HUD, which is hidden while the menu shows. -->
    <ui:Instance template="Menu" class="template-fill" picking-mode="Ignore" />

    <!-- Drawn last, so it sits above the HUD, the tutorial and the menu. It is not inside the HUD because the HUD is hidden
         while the menu shows, and the challenge list opens from the menu. Its scrim catches pointers; the wrapper around it
         does not. -->
    <ui:Instance name="popups-root" template="Popups" class="template-fill" picking-mode="Ignore" />
</ui:UXML>
